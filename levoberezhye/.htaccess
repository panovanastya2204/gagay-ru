# сжатие текстовых файлов модели (json, js, html)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/javascript text/javascript text/html text/css
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>
